<%- include('./partials/navbar') %>

<section class="wishlist-section">
  <div class="section-page-header">
    <div class="section-label">Account</div>
    <h1>My Wishlist</h1>
    <p>
      <% if (wishlist && wishlist.length > 0) { %>
        <%= wishlist.length %> saved item(s)
      <% } else { %>
        Your saved items appear here
      <% } %>
    </p>
  </div>

  <% if (!wishlist || wishlist.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">♡</div>
      <h2>Your Wishlist is Empty</h2>
      <p>Browse products and tap heart to save items here</p>
      <a href="/products" class="btn-primary">Browse Products</a>
    </div>
  <% } else { %>
    <div class="products-grid">
      <% wishlist.forEach(item => { 
          const pid = item.product_id || item.id; 
          const basePrice = Number(item.price || 0);
          const effectivePrice = Number(item.effective_price || item.price || 0);
          const availWeights = Array.isArray(item.available_weights) ? item.available_weights : (item.available_weights ? JSON.parse(item.available_weights) : []);
      %>
        <div class="product-card" id="wishlistCard-<%= pid %>"
          data-price-type="<%= item.price_type %>"
          data-product-id="<%= pid %>"
          data-product-name="<%= item.name %>"
          data-product-image="<%= item.image || '/images/placeholder.png' %>"
          data-product-category="Wishlist"
          data-base-price="<%= basePrice %>"
          data-effective-price="<%= effectivePrice %>"
          data-stock="<%= item.stock %>"
          data-weights='<%= JSON.stringify(availWeights) %>'>
          <div class="product-image">
            <a href="/products/<%= pid %>">
              <img src="<%= item.image || '/images/placeholder.png' %>" alt="<%= item.name %>" onerror="this.src='/images/placeholder.png'">
            </a>
          </div>
          <div class="product-info">
            <h3 class="product-name"><a href="/products/<%= pid %>"><%= item.name %></a></h3>
            <p class="product-price">&#8377;<%= Number(effectivePrice).toLocaleString('en-IN') %>
              <% if (item.price_type === 'kg') { %>
                <span class="price-unit-note">per kg</span>
              <% } else { %>
                <span class="price-unit-note">per unit</span>
              <% } %>
            </p>
            <% if (item.price_type === 'kg') { %>
              <div class="product-sizes-pill-list">
                <% availWeights.forEach(size => { %>
                  <button type="button" class="size-pill size-pill-btn" data-weight="<%= size %>" title="Select <%= size %>"><%= size %></button>
                <% }) %>
              </div>
            <% } %>
            <% if (item.stock === 0) { %>
              <div class="out-of-stock-label">Out of Stock</div>
            <% } else { %>
              <form action="/cart/add/<%= pid %>" method="POST" style="margin-bottom: 8px;" class="atc-form-card"
                data-price-type="<%= item.price_type %>"
                data-product-id="<%= pid %>"
                data-product-name="<%= item.name %>"
                data-product-image="<%= item.image || '/images/placeholder.png' %>"
                data-product-category="Wishlist"
                data-base-price="<%= basePrice %>"
                data-effective-price="<%= effectivePrice %>"
                data-stock="<%= item.stock %>"
                data-weights='<%= JSON.stringify(availWeights) %>'>
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="selected_weight" value="<%= availWeights[0] || '' %>">
                <button type="submit" class="add-cart-btn"><%= item.price_type === 'kg' ? 'Add to Cart ▾' : 'Add to Cart' %></button>
              </form>
            <% } %>
            <form action="/wishlist/toggle/<%= pid %>" method="POST" class="wishlist-remove-form" data-product-id="<%= pid %>">
              <button type="submit" class="btn-secondary" style="width: 100%; border-radius: 8px; font-size: 13px; padding: 8px 12px;">Remove from Wishlist</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<script>
  document.querySelectorAll('.wishlist-remove-form').forEach((form) => {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const productId = this.dataset.productId;
      try {
        const res = await fetch(`/wishlist/toggle/${productId}`, {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });
        const data = await res.json();
        if (!res.ok || !data.ok) return;
        if (data.status === 'removed') {
          const card = document.getElementById(`wishlistCard-${productId}`);
          if (card) card.remove();
          if (!document.querySelector('.wishlist-remove-form')) {
            window.location.reload();
          }
        }
      } catch (err) {
        console.error(err);
      }
    });
  });
</script>

<%- include('./partials/footer') %>
