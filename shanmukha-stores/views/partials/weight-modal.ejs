  /* Mobile Bottom Sheet Adaptation */
  @media (max-width: 640px) {
    .weight-modal-overlay {
      padding: 0;
      align-items: flex-end;
    }

    .weight-modal-sheet {
      max-width: 100%;
      border-radius: 24px 24px 0 0;
      transform: translateY(100%);
      max-height: 85vh;
      border-bottom: none;
      border-left: none;
      border-right: none;
    }

    .weight-modal-drag-handle {
      display: block;
    }

    .weight-modal-overlay.active .weight-modal-sheet {
      transform: translateY(0);
    }

    .weight-options-grid {
      grid-template-columns: 1fr;
    }

    .weight-opt-card {
      padding: 10px 14px;
    }
  }
</style>

<script>
  (function () {
    // Current Active Modal State
    let currentModalProduct = null;
    let currentSelectedWeight = null;
    let currentQty = 1;

    // Helper: Parse weight to multiplier
    function parseWeightMultiplier(weightStr) {
      if (!weightStr) return 1;
      const raw = String(weightStr).toLowerCase().replace(/\s+/g, '');
      const match = raw.match(/^(\d+(?:\.\d+)?)(kg|g|gm)$/);
      if (!match) return 1;
      const qty = parseFloat(match[1]);
      const unit = match[2];
      return unit === 'kg' ? qty : (qty / 1000);
    }

    // Format currency INR
    function formatINR(amount) {
      return Number(Math.round(amount)).toLocaleString('en-IN');
    }

    // Open Modal with Product Data
    window.openWeightModal = function (product, preselectedWeight) {
      currentModalProduct = product;
      currentQty = 1;

      const modal = document.getElementById('weightSelectModal');
      const imgEl = document.getElementById('weightModalImg');
      const titleEl = document.getElementById('weightModalTitle');
      const catEl = document.getElementById('weightModalCategory');
      const basePriceEl = document.getElementById('weightModalBasePrice');
      const offerBadge = document.getElementById('weightModalOfferBadge');
      const qtyInput = document.getElementById('weightModalQty');
      const optionsContainer = document.getElementById('weightModalOptionsList');
      const formEl = document.getElementById('weightModalForm');

      if (!modal) return;

      // Populate Product Info
      imgEl.src = product.image || '/images/placeholder.png';
      titleEl.innerText = product.name || 'Product';
      catEl.innerText = product.category || 'Grocery';

      const effectivePrice = Number(product.effectivePrice || product.price || 0);
      const basePrice = Number(product.basePrice || product.price || 0);
      const offerPercent = Number(product.offerPercent || 0);
      const hasOffer = (offerPercent > 0 || (product.offerActive && effectivePrice < basePrice));

      basePriceEl.innerHTML = '&#8377;' + formatINR(effectivePrice);
      if (hasOffer && offerPercent > 0) {
        offerBadge.innerText = Math.round(offerPercent) + '% OFF';
        offerBadge.style.display = 'inline-block';
      } else {
        offerBadge.style.display = 'none';
      }

      // Parse available weights
      let weights = [];
      try {
        if (Array.isArray(product.weights)) {
          weights = product.weights;
        } else if (typeof product.weights === 'string') {
          weights = JSON.parse(product.weights);
        }
      } catch (e) {
        weights = [];
      }

      if (!weights || !weights.length) {
        weights = ['100gm', '250gm', '500gm', '1kg'];
      }

      // Determine initial selection
      currentSelectedWeight = preselectedWeight && weights.includes(preselectedWeight)
        ? preselectedWeight
        : (weights.length ? weights[0] : '1kg');

      // Render weight options
      optionsContainer.innerHTML = '';
      weights.forEach(function (w) {
        const mult = parseWeightMultiplier(w);
        const optEffectivePrice = effectivePrice * mult;
        const optBasePrice = basePrice * mult;
        const isSelected = (w === currentSelectedWeight);

        const card = document.createElement('div');
        card.className = 'weight-opt-card' + (isSelected ? ' selected' : '');
        card.setAttribute('data-weight', w);
        card.onclick = function () {
          selectModalWeight(w);
        };

        let priceHtml = '<span class="weight-opt-price">&#8377;' + formatINR(optEffectivePrice) + '</span>';
        if (hasOffer && optBasePrice > optEffectivePrice) {
          priceHtml += '<span class="weight-opt-orig">&#8377;' + formatINR(optBasePrice) + '</span>';
        }

        card.innerHTML = `
          <div class="weight-opt-top">
            <span class="weight-opt-label">${w}</span>
            <div class="weight-opt-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
          <div class="weight-opt-prices">
            ${priceHtml}
          </div>
        `;
        optionsContainer.appendChild(card);
      });

      // Set Quantity & Form Action
      qtyInput.value = currentQty;
      formEl.action = '/cart/add/' + product.id;
      document.getElementById('weightModalFormQty').value = currentQty;
      document.getElementById('weightModalFormWeight').value = currentSelectedWeight;

      updateModalTotals();

      // Show Modal
      modal.style.display = 'flex';
      setTimeout(function () {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }, 10);
    };

    // Close Modal
    window.closeWeightModal = function () {
      const modal = document.getElementById('weightSelectModal');
      if (!modal) return;
      modal.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(function () {
        modal.style.display = 'none';
        currentModalProduct = null;
      }, 260);
    };

    // Select Weight
    window.selectModalWeight = function (weight) {
      currentSelectedWeight = weight;
      document.getElementById('weightModalFormWeight').value = weight;

      const cards = document.querySelectorAll('.weight-opt-card');
      cards.forEach(function (c) {
        if (c.getAttribute('data-weight') === weight) {
          c.classList.add('selected');
        } else {
          c.classList.remove('selected');
        }
      });

      updateModalTotals();
    };

    // Adjust Quantity
    window.adjustModalQty = function (delta) {
      let maxStock = 99;
      if (currentModalProduct && currentModalProduct.stock) {
        maxStock = parseInt(currentModalProduct.stock, 10) || 99;
      }
      currentQty = Math.max(1, Math.min(maxStock, currentQty + delta));
      document.getElementById('weightModalQty').value = currentQty;
      document.getElementById('weightModalFormQty').value = currentQty;
      updateModalTotals();
    };

    // Calculate Total Price
    function updateModalTotals() {
      if (!currentModalProduct) return;
      const effectivePrice = Number(currentModalProduct.effectivePrice || currentModalProduct.price || 0);
      const basePrice = Number(currentModalProduct.basePrice || currentModalProduct.price || 0);
      const mult = parseWeightMultiplier(currentSelectedWeight);

      const totalEffective = effectivePrice * mult * currentQty;
      const totalBase = basePrice * mult * currentQty;

      const totalEl = document.getElementById('weightModalTotalPrice');
      const origEl = document.getElementById('weightModalOrigPrice');

      if (totalEl) totalEl.innerHTML = '&#8377;' + formatINR(totalEffective);

      if (origEl) {
        if (totalBase > totalEffective) {
          origEl.innerHTML = '&#8377;' + formatINR(totalBase);
          origEl.style.display = 'inline';
        } else {
          origEl.style.display = 'none';
        }
      }
    }

    // Escape Key Listener
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeWeightModal();
      }
    });

    // Helper: Extract Product Data from an HTML element/card/form
    function extractProductData(el) {
      const card = el.closest('.product-card-luxury, .product-card, .collection-card, .wishlist-card') || el;
      const form = el.closest('form') || card.querySelector('form[action*="/cart/add/"]');

      const dataSrc = form || card;
      if (!dataSrc) return null;

      // Read from attributes
      let weights = dataSrc.getAttribute('data-weights');
      if (weights) {
        try { weights = JSON.parse(weights); } catch (e) { weights = []; }
      }

      const id = dataSrc.getAttribute('data-product-id') || (form && form.action ? (form.action.match(/\/cart\/add\/(\d+)/) || [])[1] : null);
      if (!id) return null;

      const imgEl = card.querySelector('img');
      const nameEl = card.querySelector('.product-name, h3, h4');
      const catEl = card.querySelector('.category, .product-category-tag');

      return {
        id: id,
        name: dataSrc.getAttribute('data-product-name') || (nameEl ? nameEl.innerText.trim() : 'Product'),
        category: dataSrc.getAttribute('data-product-category') || (catEl ? catEl.innerText.trim() : 'Grocery'),
        image: dataSrc.getAttribute('data-product-image') || (imgEl ? imgEl.src : '/images/placeholder.png'),
        priceType: dataSrc.getAttribute('data-price-type') || 'unit',
        basePrice: parseFloat(dataSrc.getAttribute('data-base-price') || 0),
        effectivePrice: parseFloat(dataSrc.getAttribute('data-effective-price') || dataSrc.getAttribute('data-base-price') || 0),
        offerPercent: parseFloat(dataSrc.getAttribute('data-offer-percent') || 0),
        offerActive: dataSrc.getAttribute('data-offer-active') === '1' || dataSrc.getAttribute('data-offer-active') === 'true',
        stock: parseInt(dataSrc.getAttribute('data-stock') || 99, 10),
        weights: weights || []
      };
    }

    // Click Interceptor for Size Pills & Add to Cart on KG products
    document.addEventListener('click', function (e) {
      // 1. Click on a size pill directly
      const pill = e.target.closest('.size-pill');
      if (pill) {
        const card = pill.closest('.product-card-luxury, .product-card, .collection-card, .wishlist-card');
        if (card) {
          const product = extractProductData(card);
          if (product && product.priceType === 'kg') {
            e.preventDefault();
            e.stopPropagation();
            const chosenWeight = pill.getAttribute('data-weight') || pill.innerText.trim();
            openWeightModal(product, chosenWeight);
            return;
          }
        }
      }

      // 2. Click on Add to Cart button
      const atcBtn = e.target.closest('.btn-luxury-card-atc, .add-cart-btn');
      if (atcBtn) {
        const form = atcBtn.closest('form');
        const card = atcBtn.closest('.product-card-luxury, .product-card, .collection-card, .wishlist-card');
        const product = extractProductData(card || atcBtn);

        // If product is priced in KG and user is clicking from catalog/home/wishlist
        if (product && product.priceType === 'kg') {
          e.preventDefault();
          e.stopPropagation();
          openWeightModal(product);
          return;
        }
      }
    });

    // Form Submit Interceptor for KG Product Cards (Catch Enter key or standard submit)
    document.addEventListener('submit', function (e) {
      const form = e.target;
      if (!form || !form.action || !form.action.includes('/cart/add/')) return;
      if (form.id === 'weightModalForm') {
        // Modal submission: close modal after brief delay so flying animation starts
        setTimeout(closeWeightModal, 80);
        return;
      }

      // Exclude product details page which has its own on-page weight radio selector
      if (form.classList.contains('purchase-form')) return;

      const product = extractProductData(form);
      if (product && product.priceType === 'kg') {
        e.preventDefault();
        e.stopPropagation();
        openWeightModal(product);
      }
    }, true);

  })();
</script>
