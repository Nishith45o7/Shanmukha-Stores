  .weight-opt-card.selected {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(245, 158, 11, 0.12));
    border-color: #f59e0b;
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.22);
  }

  .weight-opt-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .weight-opt-label {
    font-weight: 800;
    font-size: 15px;
    color: #ffffff;
    letter-spacing: 0.3px;
  }

  .weight-opt-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
