<!-- ============================================================
     LUXURY WEIGHT SELECTION POPUP / BOTTOM-SHEET MODAL
     Appears when clicking "Add to Cart" on any product priced by weight (KG)
============================================================ -->
<div id="weightSelectModal" class="weight-modal-overlay" aria-hidden="true" style="display: none;">
  <div class="weight-modal-backdrop" onclick="closeWeightModal()"></div>
  <div class="weight-modal-sheet" role="dialog" aria-modal="true" aria-labelledby="weightModalTitle">
    <div class="weight-modal-drag-handle" aria-hidden="true"></div>

    <!-- Header: Product Info -->
    <div class="weight-modal-header">
      <div class="weight-modal-product-summary">
        <div class="weight-modal-thumb-wrap">
          <img id="weightModalImg" src="/images/placeholder.png" alt="Product" class="weight-modal-thumb" onerror="this.src='/images/placeholder.png'">
        </div>
        <div class="weight-modal-titles">
          <span id="weightModalCategory" class="weight-modal-cat">Bespoke</span>
          <h3 id="weightModalTitle" class="weight-modal-name">Select Weight</h3>
          <div class="weight-modal-base-price">
            <span class="base-price-label">Price:</span>
            <span id="weightModalBasePrice" class="base-price-tag">&#8377;0</span>
            <span class="base-price-unit">/ kg</span>
            <span id="weightModalOfferBadge" class="modal-offer-badge" style="display: none;">10% OFF</span>
          </div>
        </div>
      </div>
      <button type="button" class="weight-modal-close" onclick="closeWeightModal()" aria-label="Close weight selection">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body: Weight Options -->
    <div class="weight-modal-body">
      <div class="weight-modal-section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        <span>Choose Pack Size / Weight</span>
      </div>

      <div id="weightModalOptionsList" class="weight-options-grid">
        <!-- Rendered dynamically via JavaScript -->
      </div>

      <!-- Quantity Row -->
      <div class="weight-modal-qty-row">
        <div class="qty-info">
          <span class="qty-label">Quantity</span>
          <span class="qty-hint">Number of packs</span>
        </div>
        <div class="modal-qty-stepper">
          <button type="button" class="modal-qty-btn minus" onclick="adjustModalQty(-1)" aria-label="Decrease quantity">−</button>
          <input type="number" id="weightModalQty" value="1" min="1" max="99" readonly aria-label="Selected quantity">
          <button type="button" class="modal-qty-btn plus" onclick="adjustModalQty(1)" aria-label="Increase quantity">+</button>
        </div>
      </div>
    </div>

    <!-- Footer: Total & Add to Cart -->
    <div class="weight-modal-footer">
      <div class="modal-footer-price">
        <span class="total-label">Total Price</span>
        <div class="total-price-wrap">
          <span id="weightModalTotalPrice" class="total-amount">&#8377;0</span>
          <span id="weightModalOrigPrice" class="orig-amount" style="display: none;">&#8377;0</span>
        </div>
      </div>
      <form id="weightModalForm" action="" method="POST" class="modal-atc-form">
        <input type="hidden" name="quantity" id="weightModalFormQty" value="1">
        <input type="hidden" name="selected_weight" id="weightModalFormWeight" value="">
        <button type="submit" id="weightModalSubmitBtn" class="btn-modal-atc">
          <span>Add to Cart</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  /* ============================================================
     WEIGHT SELECTION MODAL STYLES (LUXURY THEME)
  ============================================================ */
  .weight-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
  }

  .weight-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .weight-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .weight-modal-sheet {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 460px;
    background: #0f172a; /* deep luxury slate */
