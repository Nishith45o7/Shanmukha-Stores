  /* Body */
  .weight-modal-body {
    padding: 16px 20px;
    overflow-y: auto;
    flex: 1;
  }

  .weight-modal-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #cbd5e1;
    margin-bottom: 12px;
  }

  .weight-modal-section-title svg {
    color: #f59e0b;
  }

  /* Options Grid */
  .weight-options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .weight-opt-card {
