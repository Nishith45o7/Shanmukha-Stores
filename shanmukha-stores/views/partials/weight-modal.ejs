    border: 1px solid rgba(245, 158, 11, 0.3); /* gold accent */
    border-radius: 20px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 35px rgba(245, 158, 11, 0.15);
    transform: scale(0.92) translateY(14px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 40px);
  }

  .weight-modal-overlay.active .weight-modal-sheet {
    transform: scale(1) translateY(0);
  }

  .weight-modal-drag-handle {
    display: none;
    width: 40px;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin: 8px auto 0;
  }

  /* Header */
  .weight-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 18px 20px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    gap: 12px;
  }

  .weight-modal-product-summary {
    display: flex;
    align-items: center;
