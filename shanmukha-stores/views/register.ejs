<%- include('./partials/navbar') %>

    <section class="auth-section">
        <div class="auth-container">
            <div class="auth-left">
                <div class="section-label" style="margin-bottom:16px">Join Us</div>
                <h1>Create Your Free Account</h1>
                <p>Join thousands of happy customers enjoying fresh organic groceries delivered to their doorstep.</p>
                <div class="auth-benefit"><span class="icon">🚚</span> Free delivery over ₹499</div>
                <div class="auth-benefit"><span class="icon">🌿</span> 100% organic certified products</div>
                <div class="auth-benefit"><span class="icon">🔄</span> Easy & hassle-free returns</div>
                <div class="auth-benefit"><span class="icon">🎁</span> Exclusive new-member deals</div>
            </div>
            <div class="auth-card">
                <h2>Create Account</h2>
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="auth-alert error">⚠️ <%= error %>
                    </div>
                    <% } %>
                        <% if (typeof success !=='undefined' && success) { %>
                            <div class="auth-alert success">✅ <%= success %>
                            </div>
                            <% } %>
                                <form action="/auth/register" method="POST" class="auth-form" onsubmit="return validateForm()">
                                    <div class="form-group">
                                        <label class="form-label">Full Name *</label>
                                        <input type="text" name="full_name" class="form-input"
                                            required autocomplete="name">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Email Address</label>
                                        <input type="email" name="email" class="form-input"
                                            autocomplete="email">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Mobile Number *</label>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="tel" name="phone" id="regPhone" class="form-input" required autocomplete="tel" style="flex: 1;">
                                            <button type="button" class="auth-btn" id="sendOtpBtn" onclick="sendOTP()" style="width: auto; padding: 0 16px; font-size: 14px;">Send OTP</button>
                                        </div>
                                    </div>
                                    <div class="form-group" id="otpGroup" style="display: none;">
                                        <label class="form-label">OTP *</label>
                                        <input type="text" name="otp" id="regOtp" class="form-input" placeholder="Enter OTP">
                                        <small id="otpMessage" style="color: #2c7a4b; display: block; margin-top: 4px; font-size: 12px;"></small>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Password *</label>
                                        <div class="password-wrap">
                                            <input type="password" name="password" class="form-input"
                                                required id="regPass"
                                                autocomplete="new-password" oninput="checkPasswordStrength(this.value)">
                                            <span class="toggle-pass" onclick="togglePass('regPass', this)">👁</span>
                                        </div>
                                        <div class="password-strength" id="strengthBar"></div>
                                        <ul class="password-hints" id="passwordHints">
                                            <li id="hint-length" class="hint-fail">At least 6 characters</li>
                                            <li id="hint-upper" class="hint-fail">One uppercase letter</li>
                                            <li id="hint-number" class="hint-fail">One number</li>
                                        </ul>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Confirm Password *</label>
                                        <div class="password-wrap">
                                            <input type="password" name="confirm_password" class="form-input"
                                                required id="regPassConfirm"
                                                autocomplete="new-password">
                                            <span class="toggle-pass" onclick="togglePass('regPassConfirm', this)">👁</span>
                                        </div>
                                    </div>
                                    <button type="submit" class="auth-btn" style="margin-top:4px">Create Account
                                        →</button>
                                </form>

                                <div class="auth-divider">
                                  <span>OR</span>
                                </div>

                                <div class="social-auth-wrap">
                                  <a href="/auth/google" class="google-auth-btn" id="googleRegisterBtn" data-client-id="<%= typeof googleClientId !== 'undefined' ? googleClientId : '' %>">
                                    <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24">
                                      <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                                      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.27 21.39 7.35 24 12 24z"/>
                                      <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.16 0 9.98 0 12s.45 3.84 1.25 5.42l4.03-3.15z"/>
                                      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.27 2.61 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                                    </svg>
                                    <span>Sign up with Google</span>
                                  </a>
                                </div>

                                <div class="auth-bottom">
                                    Already have an account? <a href="/auth/login">Login</a>
                                </div>
            </div>
        </div>
    </section>

    <%- include('./partials/footer') %>
        <script>
            function togglePass(id, btn) {
                const input = document.getElementById(id);
                if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
                else { input.type = 'password'; btn.textContent = '👁'; }
            }
            function checkPasswordStrength(val) {
                const lengthPass = val.length >= 6;
                const upperPass = /[A-Z]/.test(val);
                const numberPass = /[0-9]/.test(val);
                
                document.getElementById('hint-length').className = lengthPass ? 'hint-pass' : 'hint-fail';
                document.getElementById('hint-upper').className = upperPass ? 'hint-pass' : 'hint-fail';
                document.getElementById('hint-number').className = numberPass ? 'hint-pass' : 'hint-fail';

                let strength = 0;
                if (lengthPass) strength++;
                if (upperPass) strength++;
                if (numberPass) strength++;
                if (/[^A-Za-z0-9]/.test(val)) strength++;
                
                const bar = document.getElementById('strengthBar');
                if (val.length === 0) {
                    bar.style.width = '0%';
                    bar.style.backgroundColor = 'transparent';
                } else if (strength <= 1) {
                    bar.style.width = '33%';
                    bar.style.backgroundColor = '#ff4d4d'; // Weak (Red)
                } else if (strength === 2 || strength === 3) {
                    bar.style.width = '66%';
                    bar.style.backgroundColor = '#ffa64d'; // Medium (Orange)
                } else {
                    bar.style.width = '100%';
                    bar.style.backgroundColor = '#2c7a4b'; // Strong (Green)
                }
            }
            async function sendOTP() {
                const phoneInput = document.getElementById('regPhone');
                const phone = phoneInput.value.trim();
                if (!phone || phone.length < 10) {
                    alert("Please enter a valid mobile number.");
                    return;
                }

                const btn = document.getElementById('sendOtpBtn');
                btn.disabled = true;
                btn.innerText = "Sending...";

                try {
                    const response = await fetch('/auth/send-otp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ phone })
                    });
                    const data = await response.json();
                    
                    if (data.success) {
                        document.getElementById('otpGroup').style.display = 'block';
                        document.getElementById('regOtp').required = true;
                        document.getElementById('otpMessage').innerText = data.message;
                        document.getElementById('otpMessage').style.color = '#2c7a4b';
                        btn.innerText = "Sent";
                    } else {
                        btn.disabled = false;
                        btn.innerText = "Send OTP";
                        alert(data.message || "Failed to send OTP.");
                    }
                } catch (err) {
                    btn.disabled = false;
                    btn.innerText = "Send OTP";
                    alert("An error occurred while sending OTP.");
                }
            }

            function validateForm() {
                const pwd = document.getElementById('regPass').value;
                const cpwd = document.getElementById('regPassConfirm').value;
                if (pwd !== cpwd) {
                    alert('Passwords do not match!');
                    return false;
                }
                const otp = document.getElementById('regOtp');
                if (otp && otp.required && !otp.value.trim()) {
                    alert('Please enter the OTP!');
                    return false;
                }
                return true;
            }
        </script>
        <style>
            .password-strength {
                height: 4px;
                width: 0%;
                background-color: transparent;
                border-radius: 2px;
                margin-top: 8px;
                transition: all 0.3s ease;
            }
        </style>
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script src="/js/google-auth.js" defer></script>