<%- include('./partials/navbar') %>

<section class="orders-section order-detail-container">
  <!-- Section Header -->
  <div class="order-detail-header">
    <div class="order-detail-meta">
      <div class="order-breadcrumb">
        <a href="/orders" class="breadcrumb-back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Orders
        </a>
      </div>
      <div class="order-title-wrap">
        <h1 class="order-page-title">Order #<%= order.id %></h1>
        <span class="status-pill status-<%= (order.status || '').toLowerCase() %>">
          <span class="status-dot"></span> <%= order.status %>
        </span>
      </div>
      <p class="order-date-text">
        Placed on <%= new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
        at <%= new Date(order.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
      </p>
    </div>
    <div class="order-header-actions">
      <a href="/orders/invoice/<%= order.id %>" class="btn-invoice-download" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download Invoice
      </a>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash-msg error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="flash-msg success"><%= success %></div>
  <% } %>

  <!-- Order Status Tracker -->
  <% if (typeof statusTimeline !== 'undefined' && statusTimeline && statusTimeline.length > 0) { %>
    <div class="order-card status-card">
      <div class="card-head-luxury">
        <div class="card-head-left">
          <span class="card-head-icon">📦</span>
          <h2 class="card-head-title">Order Status</h2>
        </div>
      </div>
      <div class="order-timeline-scroll">
        <div class="order-timeline">
          <% statusTimeline.forEach((step, idx) => {
            const isDone = idx < currentStatusIndex;
            const isActive = idx === currentStatusIndex;
          %>
            <div class="timeline-step <%= isDone ? 'done' : '' %> <%= isActive ? 'active-step' : '' %>">
              <div class="timeline-dot">
                <% if (isDone) { %>
                  ✓
                <% } else { %>
                  <%= step.icon %>
                <% } %>
              </div>
              <div class="timeline-label"><%= step.label %></div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Order Meta Information Grid (Order Info + Delivery Address) -->
  <div class="order-meta-grid">
    <!-- Card 1: Order Info -->
    <div class="order-card order-info-card">
      <div class="card-head-luxury">
        <div class="card-head-left">
          <span class="card-head-icon">📋</span>
          <h3 class="card-head-title">Order Information</h3>
        </div>
        <span class="order-id-chip">#<%= order.id %></span>
      </div>

      <div class="order-kv-list">
        <div class="order-kv-item">
          <span class="kv-label">Order Status</span>
          <span class="status-pill status-<%= (order.status || '').toLowerCase() %>">
            <span class="status-dot"></span> <%= order.status %>
          </span>
        </div>

        <div class="order-kv-item">
          <span class="kv-label">Payment Method</span>
          <span class="payment-method-chip">
            <% if ((order.payment_method || '').toLowerCase().includes('whatsapp')) { %>
              <span class="method-icon">💬</span> WhatsApp UPI
            <% } else if ((order.payment_method || '').toLowerCase().includes('online') || (order.payment_method || '').toLowerCase().includes('razorpay')) { %>
              <span class="method-icon">💳</span> Online Payment
            <% } else { %>
              <span class="method-icon">💵</span> <%= (order.payment_method || 'COD').toUpperCase() %>
            <% } %>
          </span>
        </div>

        <% if (typeof order.payment_status !== 'undefined' && order.payment_status) { %>
          <div class="order-kv-item">
            <span class="kv-label">Payment Status</span>
            <span class="pay-status-pill <%= order.payment_status.toLowerCase() %>">
              <%= order.payment_status.toUpperCase() %>
            </span>
          </div>
        <% } %>

        <div class="order-kv-item">
          <span class="kv-label">Grand Total</span>
          <strong class="kv-total-val">&#8377;<%= Number(order.total_amount).toLocaleString('en-IN') %></strong>
        </div>

        <% if (deliveryLabel) { %>
          <div class="order-kv-item">
            <span class="kv-label">Delivery Service</span>
            <span class="delivery-label-chip"><%= deliveryLabel %></span>
          </div>
        <% } %>

        <% if (order.estimated_delivery_at) { %>
          <div class="order-kv-item">
            <span class="kv-label">Estimated Delivery</span>
            <strong><%= new Date(order.estimated_delivery_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
          </div>
        <% } %>

        <% if (order.awb_number) { %>
          <div class="order-kv-item">
            <span class="kv-label">Courier Partner</span>
            <span style="font-weight: 700; color: #0284c7;">🚚 <%= order.courier_name || 'Delhivery' %></span>
          </div>
          <div class="order-kv-item">
            <span class="kv-label">Tracking Number (AWB)</span>
            <strong style="font-family: monospace; letter-spacing: 0.5px;"><%= order.awb_number %></strong>
          </div>
          <div style="margin-top: 10px;">
            <a href="https://www.delhivery.com/track/package/<%= order.awb_number %>" target="_blank" rel="noopener noreferrer" class="btn-primary" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; border-radius: 8px; padding: 10px; font-weight: 700; text-decoration: none;">
              🔍 Track Live on Delhivery
            </a>
          </div>
        <% } %>

        <% if (order.delivery_note) { %>
          <div class="order-callout-box update-box">
            <div class="callout-header">📦 Delivery Update:</div>
            <div class="callout-text"><%= order.delivery_note %></div>
          </div>
        <% } %>

        <% if (order.cancel_reason) { %>
          <div class="order-callout-box cancel-box">
            <div class="callout-header">⚠️ Cancellation Reason:</div>
            <div class="callout-text"><%= order.cancel_reason %></div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Card 2: Delivery Address -->
    <div class="order-card order-address-card">
      <div class="card-head-luxury">
        <div class="card-head-left">
          <span class="card-head-icon">📍</span>
          <h3 class="card-head-title">Delivery Address</h3>
        </div>
      </div>

      <% if (order.addr_name) { %>
        <div class="address-card-body">
          <div class="address-contact-banner">
            <div class="contact-avatar">👤</div>
            <div class="contact-details">
              <div class="contact-name"><%= order.addr_name %></div>
              <% if (order.addr_phone) { %>
                <div class="contact-phone">
                  <a href="tel:<%= order.addr_phone %>" class="phone-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span><%= order.addr_phone %></span>
                  </a>
                </div>
              <% } %>
            </div>
          </div>

          <div class="address-info-panel">
            <div class="panel-icon">🏠</div>
            <div class="panel-address-text">
              <div class="street-address"><%= order.address_line %></div>
              <div class="locality-address">
                <%= order.city %>, <%= order.state %> - <strong><%= order.pincode %></strong>
              </div>
            </div>
          </div>
        </div>
      <% } else if (order.address_snapshot) { %>
        <div class="address-card-body">
          <div class="address-info-panel">
            <div class="panel-icon">📍</div>
            <div class="panel-address-text">
              <div class="street-address"><%= order.address_snapshot %></div>
            </div>
          </div>
        </div>
      <% } else { %>
        <p class="muted-text">No delivery address on record.</p>
      <% } %>
    </div>
  </div>

  <!-- Card 3: Items Ordered -->
  <div class="order-card order-items-card">
    <div class="card-head-luxury">
      <div class="card-head-left">
        <span class="card-head-icon">🛍️</span>
        <h3 class="card-head-title">Items Ordered</h3>
      </div>
      <span class="items-count-chip"><%= items.reduce((s, it) => s + (it.quantity || 1), 0) %> item<%= items.reduce((s, it) => s + (it.quantity || 1), 0) === 1 ? '' : 's' %></span>
    </div>

    <!-- Desktop Items Table (Screen width > 640px) -->
    <div class="desktop-items-view">
      <table class="items-table">
        <thead>
          <tr>
            <th>Product</th>
            <th class="text-center">Quantity</th>
            <th class="text-right">Price</th>
            <th class="text-right">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
            <tr>
              <td>
                <div class="order-item-inline">
                  <img src="<%= item.image || '/images/placeholder.png' %>" alt="<%= item.name %>" class="order-item-img" onerror="this.src='/images/placeholder.png'">
                  <div class="order-item-text">
                    <a href="/products/<%= item.product_id %>" class="order-item-name"><%= item.name %></a>
                    <% if (item.selected_weight) { %>
                      <span class="order-item-weight-tag"><%= item.selected_weight %></span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td class="text-center font-semibold"><%= item.quantity %></td>
              <td class="text-right">&#8377;<%= Number(item.price).toLocaleString('en-IN') %></td>
              <td class="text-right font-bold">&#8377;<%= Number(item.price * item.quantity).toLocaleString('en-IN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Items List (Screen width <= 640px) -->
    <div class="mobile-items-view">
      <% items.forEach(item => { %>
        <div class="mobile-order-item">
          <div class="mobile-item-thumb-box">
            <img src="<%= item.image || '/images/placeholder.png' %>" alt="<%= item.name %>" class="mobile-item-img" onerror="this.src='/images/placeholder.png'">
          </div>
          <div class="mobile-item-content">
            <div class="mobile-item-top-line">
              <a href="/products/<%= item.product_id %>" class="mobile-item-title"><%= item.name %></a>
              <span class="mobile-item-line-total">&#8377;<%= Number(item.price * item.quantity).toLocaleString('en-IN') %></span>
            </div>
            <% if (item.selected_weight) { %>
              <div class="mobile-item-weight-badge"><%= item.selected_weight %></div>
            <% } %>
            <div class="mobile-item-pricing-calc">
              <span class="calc-qty">Qty: <strong><%= item.quantity %></strong></span>
              <span class="calc-sep">×</span>
              <span class="calc-unit-rate">&#8377;<%= Number(item.price).toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Order Financial Breakdown -->
    <div class="order-summary-breakdown">
      <% 
        const itemsTotal = items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const orderTotal = Number(order.total_amount);
        const discountAmount = Number(order.discount_amount) || (itemsTotal > orderTotal ? itemsTotal - orderTotal : 0);
      %>
      <div class="summary-row">
        <span class="summary-label">Items Subtotal</span>
        <strong class="summary-val">&#8377;<%= Number(itemsTotal).toLocaleString('en-IN') %></strong>
      </div>

      <% if (discountAmount > 0) { %>
        <div class="summary-row discount-row">
          <span class="summary-label">Coupon Discount <%= order.coupon_code ? `(${order.coupon_code})` : '' %></span>
          <strong class="summary-val discount-val">-&#8377;<%= Number(discountAmount).toLocaleString('en-IN') %></strong>
        </div>
      <% } %>

      <div class="summary-row">
        <span class="summary-label">Delivery Fee</span>
        <span class="delivery-free-tag">FREE</span>
      </div>

      <div class="summary-grand-total">
        <div class="total-text-group">
          <span class="total-title">Total Amount</span>
          <span class="total-sub">Inclusive of all taxes</span>
        </div>
        <strong class="total-price-val">&#8377;<%= Number(order.total_amount).toLocaleString('en-IN') %></strong>
      </div>
    </div>
  </div>

  <!-- Order Action Buttons -->
  <div class="order-detail-actions-panel">
    <div class="actions-group-primary">
      <a href="/orders" class="btn-action-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Orders
      </a>
      <a href="/orders/invoice/<%= order.id %>" class="btn-action-invoice" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download Invoice
      </a>
    </div>

    <div class="actions-group-secondary">
      <% if (typeof returnRequest !== 'undefined' && returnRequest) { %>
        <div class="return-status-banner">Return Status: <strong><%= returnRequest.status %></strong></div>
      <% } %>

      <% if (canReturn) { %>
        <button type="button" class="btn-action-return" id="openReturnModalBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          Request Return
        </button>
        <% if (returnWindowEndsAt) { %>
          <span class="return-window-hint">Return window ends on <%= new Date(returnWindowEndsAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
        <% } %>
      <% } %>

      <% if (canCancel) { %>
        <button type="button" class="btn-action-cancel" id="openCancelModalBtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          Cancel Order
        </button>
      <% } %>
    </div>
  </div>
</section>

<!-- Cancel Order Modal -->
<div class="reason-modal-backdrop" id="cancelReasonModal" aria-hidden="true">
  <div class="reason-modal-card">
    <div class="reason-modal-head">
      <h3>Cancel Order #<%= order.id %></h3>
      <button type="button" class="reason-close" data-close-modal="cancelReasonModal">✕</button>
    </div>
    <form method="POST" action="/orders/cancel/<%= order.id %>">
      <label for="cancelReasonInput">Cancellation Reason *</label>
      <textarea id="cancelReasonInput" name="reason" rows="4" minlength="3" required placeholder="Please tell us why you want to cancel this order..."></textarea>
      <div class="reason-actions">
        <button type="submit" class="btn-danger btn-sm">Confirm Cancel</button>
        <button type="button" class="btn-secondary btn-sm" data-close-modal="cancelReasonModal">Close</button>
      </div>
    </form>
  </div>
</div>

<!-- Return Request Modal -->
<div class="reason-modal-backdrop" id="returnReasonModal" aria-hidden="true">
  <div class="reason-modal-card">
    <div class="reason-modal-head">
      <h3>Request Return for Order #<%= order.id %></h3>
      <button type="button" class="reason-close" data-close-modal="returnReasonModal">✕</button>
    </div>
    <form method="POST" action="/orders/return/<%= order.id %>">
      <label for="returnReasonInput">Reason for Return *</label>
      <textarea id="returnReasonInput" name="reason" rows="4" minlength="3" required placeholder="Please explain the reason for your return request..."></textarea>
      <div class="reason-actions">
        <button type="submit" class="btn-primary btn-sm">Submit Return Request</button>
        <button type="button" class="btn-secondary btn-sm" data-close-modal="returnReasonModal">Close</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const cancelModal = document.getElementById('cancelReasonModal');
    const returnModal = document.getElementById('returnReasonModal');

    function openModal(modal) {
      if (!modal) return;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(modal) {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.getElementById('openCancelModalBtn')?.addEventListener('click', () => openModal(cancelModal));
    document.getElementById('openReturnModalBtn')?.addEventListener('click', () => openModal(returnModal));

    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-close-modal');
        closeModal(document.getElementById(id));
      });
    });

    [cancelModal, returnModal].forEach((modal) => {
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal(modal);
      });
    });
  })();
</script>

<%- include('./partials/footer') %>

<!-- Scoped Luxury Styles for Order Details Page -->
<style>
/* Header Styles */
.order-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}
.order-breadcrumb {
  margin-bottom: 6px;
}
.breadcrumb-back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--green, #1C4A30);
  transition: opacity 0.2s;
}
.breadcrumb-back-link:hover {
  opacity: 0.8;
}
.order-title-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.order-page-title {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--black, #111);
  margin: 0;
  letter-spacing: -0.5px;
}
.order-date-text {
  font-size: 13px;
  color: var(--gray-500, #71717a);
  margin-top: 4px;
  margin-bottom: 0;
}
.btn-invoice-download {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--black, #111);
  color: #fff !important;
  font-size: 13px;
  font-weight: 600;
  padding: 10px 18px;
  border-radius: 99px;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}
.btn-invoice-download:hover {
  background: var(--green, #1C4A30);
  transform: translateY(-1px);
}

/* Card Luxury Header */
.card-head-luxury {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 14px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.08));
}
.card-head-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
.card-head-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: rgba(28, 74, 48, 0.08);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.card-head-title {
  font-size: 17px;
  font-weight: 700;
  margin: 0;
  color: var(--black, #111);
}
.order-id-chip {
  font-size: 12px;
  font-weight: 700;
  color: var(--gray-500, #666);
  background: rgba(0, 0, 0, 0.05);
  padding: 4px 10px;
  border-radius: 6px;
}
.items-count-chip {
  font-size: 12px;
  font-weight: 600;
  color: var(--green, #1C4A30);
  background: rgba(28, 74, 48, 0.08);
  padding: 4px 10px;
  border-radius: 99px;
}

/* Status Timeline Scrolling */
.order-timeline-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 4px;
}
.order-timeline-scroll::-webkit-scrollbar {
  display: none;
}

/* Key-Value List */
.order-kv-list {
  display: flex;
  flex-direction: column;
}
.order-kv-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px dashed var(--border, rgba(0, 0, 0, 0.08));
  font-size: 13.5px;
}
.order-kv-item:last-child {
  border-bottom: none;
}
.kv-label {
  color: var(--gray-500, #71717a);
  font-weight: 500;
  font-size: 13px;
}
.kv-total-val {
  font-size: 16px;
  font-weight: 700;
  color: var(--green, #1C4A30);
}

/* Status Pills */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 99px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}
.status-pill.status-pending,
.status-pill.pending {
  background: #fef9c3;
  color: #a16207;
}
.status-pill.status-confirmed,
.status-pill.status-processing,
.status-pill.confirmed,
.status-pill.processing {
  background: #e0f2fe;
  color: #0369a1;
}
.status-pill.status-shipped,
.status-pill.shipped {
  background: #ffedd5;
  color: #c2410c;
}
.status-pill.status-delivered,
.status-pill.delivered {
  background: #dcfce7;
  color: #15803d;
}
.status-pill.status-cancelled,
.status-pill.cancelled {
  background: #fee2e2;
  color: #b91c1c;
}

