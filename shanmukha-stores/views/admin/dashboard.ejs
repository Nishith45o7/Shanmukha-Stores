<%- include('_header') %>

<style>
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .dash-header h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #1A1A1A;
    }
    .dash-date-picker {
        background: #EAE3DE;
        color: #6C5B51;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dash-filter-select {
        background: #F5F5F5;
        border: none;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #737373;
        outline: none;
        cursor: pointer;
    }
    .chart-container {
        position: relative;
        width: 100%;
    }
    .stat-diff {
        font-size: 12px;
        color: #A3A3A3;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .stat-diff span {
        color: #1A1A1A;
    }
</style>

<div class="dash-header">
    <h2>Welcome back, <%= user.name || 'Admin' %></h2>

</div>

<!-- STATS CARDS -->
<div class="stats-row-custom" style="margin-bottom: 24px;">
    <!-- Income -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFF6F0; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/analytics'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Income</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2c7a4b" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><polyline points="21 3 21 8 16 8"></polyline></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;">₹<%= stats.revenue %></div>
        <div class="stat-diff">
            <% if (typeof growth !== 'undefined' && growth && growth.revenue >= 0) { %>
                <span style="color:#16a34a; font-weight:600;">↑ +<%= growth.revenue %>%</span> vs prior month
            <% } else if (typeof growth !== 'undefined' && growth) { %>
                <span style="color:#dc2626; font-weight:600;">↓ <%= growth.revenue %>%</span> vs prior month
            <% } else { %>
                <span>—</span> vs prior month
            <% } %>
        </div>
    </div>
    
    <!-- Orders -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/orders'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Orders</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFF6F0; display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2c7a4b" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;"><%= stats.orders %></div>
        <div class="stat-diff">
            <% if (typeof growth !== 'undefined' && growth && growth.orders >= 0) { %>
                <span style="color:#16a34a; font-weight:600;">↑ +<%= growth.orders %>%</span> vs prior month
            <% } else if (typeof growth !== 'undefined' && growth) { %>
                <span style="color:#dc2626; font-weight:600;">↓ <%= growth.orders %>%</span> vs prior month
            <% } else { %>
                <span>—</span> vs prior month
            <% } %>
        </div>
    </div>

    <!-- Average check -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/analytics'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Average Check</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFF6F0; display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2c7a4b" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;">₹<%= stats.avgOrderValue %></div>
        <div class="stat-diff">
            <% if (typeof growth !== 'undefined' && growth && growth.avgOrderValue >= 0) { %>
                <span style="color:#16a34a; font-weight:600;">↑ +<%= growth.avgOrderValue %>%</span> vs prior month
            <% } else if (typeof growth !== 'undefined' && growth) { %>
                <span style="color:#dc2626; font-weight:600;">↓ <%= growth.avgOrderValue %>%</span> vs prior month
            <% } else { %>
                <span>—</span> vs prior month
            <% } %>
        </div>
    </div>
</div>

<!-- CHARTS AREA -->
<div class="dashboard-charts-grid" style="margin-bottom: 24px;">
    <!-- LEFT COLUMN -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Product Sales Line Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Sales Revenue Trend</div>
                    <div style="font-size: 12px; color: #737373;">Live orders & revenue performance</div>
                </div>
                <select class="dash-filter-select dash-period-select" onchange="changeDashPeriod(this.value)">
                    <option value="7" <%= (typeof period === 'undefined' || period == 7) ? 'selected' : '' %>>Weekly (7 Days)</option>
                    <option value="30" <%= (typeof period !== 'undefined' && period == 30) ? 'selected' : '' %>>Monthly (30 Days)</option>
                </select>
            </div>
            <div class="chart-container" style="height: 260px;">
                <canvas id="productSalesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Categories Doughnut Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Category Performance</div>
                <select class="dash-filter-select dash-period-select" onchange="changeDashPeriod(this.value)">
                    <option value="7" <%= (typeof period === 'undefined' || period == 7) ? 'selected' : '' %>>Weekly (7 Days)</option>
                    <option value="30" <%= (typeof period !== 'undefined' && period == 30) ? 'selected' : '' %>>Monthly (30 Days)</option>
                </select>
            </div>
            <div class="chart-container" style="height: 200px;">
                <canvas id="categoriesChart"></canvas>
            </div>
        </div>

        <!-- Sales by City Bar Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Top Delivery Cities</div>
                <select class="dash-filter-select dash-period-select" onchange="changeDashPeriod(this.value)">
                    <option value="7" <%= (typeof period === 'undefined' || period == 7) ? 'selected' : '' %>>Weekly (7 Days)</option>
                    <option value="30" <%= (typeof period !== 'undefined' && period == 30) ? 'selected' : '' %>>Monthly (30 Days)</option>
                </select>
            </div>
            <div class="chart-container" style="height: 150px;">
                <canvas id="cityChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ADDITIONAL STATS AND LISTS -->
<div class="stats-row-dynamic" style="margin-top: 24px;">
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/orders?status=Pending'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Pending Orders</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.pending %></div>
        <div style="font-size: 12px; color: #737373;">Awaiting fulfillment</div>
    </div>
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/products'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Total Products</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.products %></div>
        <div style="font-size: 12px; color: #737373;">In active catalog</div>
    </div>
    <% if (user.role==='admin' ) { %>
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/users'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Total Users</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.users %></div>
        <div style="font-size: 12px; color: #737373;">Registered patrons</div>
    </div>
    <% } %>
</div>

<div class="<%= user.role === 'admin' ? 'grid-2' : 'grid-1' %>" style="gap:24px; margin-top:24px;">
    <!-- RECENT ORDERS -->
    <div class="luxury-card" style="padding:0; border:none; box-shadow: var(--shadow-sm); border-radius:16px; overflow:hidden;">
        <div class="card-hd" style="padding:24px; background: var(--surface); border-bottom: 1px solid var(--line);">
            <h3 class="luxury-text" style="font-size:16px; margin:0;">Recent Acquisitions</h3>
            <a href="/admin/orders" class="btn btn-ghost btn-sm" style="border-radius:8px;">View Full Registry</a>
        </div>
        <div class="tbl-wrap">
            <table style="border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: var(--gray-50);">
                        <th style="padding:15px 24px;">Ref #</th>
                        <th>Patron</th>
                        <th>Valuation</th>
                        <th style="padding-right:24px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentOrders && recentOrders.length > 0) { %>
                        <% recentOrders.forEach(function(o) { %>
                            <tr style="transition: background 0.3s; cursor: pointer;" onclick="window.location.href='/admin/orders/<%= o.id %>'">
                                <td style="padding:15px 24px; font-weight:600; color:var(--emerald);">#<%= o.id %></td>
                                <td style="font-weight:500;"><%= user.role==='admin' ? o.user_name : 'Staff Member ' + o.id %></td>
                                <td style="font-weight:600;">₹<%= Number(o.total_amount).toLocaleString('en-IN') %></td>
                                <td style="padding-right:24px;">
                                    <% if(o.status==='Delivered' ) { %>
                                        <span class="badge bg-green">Fulfilled</span>
                                    <% } else if(o.status==='Pending' ) { %>
                                        <span class="badge bg-orange">Awaiting</span>
                                    <% } else if(o.status==='Cancelled' ) { %>
                                        <span class="badge bg-red">Rescinded</span>
                                    <% } else { %>
                                        <span class="badge bg-blue"><%= o.status %></span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align:center; padding:32px; color:#737373;">No orders placed yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- CURATOR ACTIVITY -->
    <div class="curator-activity luxury-card" style="cursor: pointer; padding:0; border:none; border-radius:16px; overflow:hidden;" onclick="window.location.href='/admin/staff'">
        <div class="card-hd" style="padding:24px; background: var(--surface); border-bottom: 1px solid var(--line);">
            <h3 style="font-size:16px; margin:0; font-family: 'Plus Jakarta Sans', sans-serif;">Curator Activity</h3>
        </div>
        <div class="activity-list" style="padding:24px; max-height: 400px; overflow-y: auto;">
            <% if(typeof activities !=='undefined' && activities && activities.length> 0) { %>
                <% activities.forEach(act=> { %>
                    <div class="activity-item" style="display:flex; gap:12px; margin-bottom:16px;">
                        <div class="act-point" style="width:8px; height:8px; border-radius:50%; background:#2c7a4b; margin-top:6px; flex-shrink:0;"></div>
                        <div class="act-content">
                            <div class="act-title" style="font-size:13px; color:#1A1A1A;"><strong><%= act.user_name %></strong> <%= act.action %></div>
                            <div class="act-meta" style="font-size:11px; color:#A3A3A3; margin-top:4px;"><%= new Date(act.timestamp || act.created_at).toLocaleTimeString() %> • <%= (act.details && (act.details.name || act.details.email)) || '' %></div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="empty-msg" style="text-align:center; color:#A3A3A3; font-size:13px; padding:24px;">No recent curator activity.</p>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Data from Backend
    const chartsData = <%- JSON.stringify(typeof chartsData !== 'undefined' ? chartsData : { revenueByDay: [], revenueByCategory: [], salesByCity: [] }) %>;
    
    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
    Chart.defaults.color = "#737373";

    let salesChartInstance = null;
    let categoriesChartInstance = null;
    let cityChartInstance = null;

    function renderAllCharts(data) {
        const revData = data.revenueByDay || [];
        const catData = data.revenueByCategory || [];
        const cityData = data.salesByCity || [];

        const salesLabels = revData.map(d => d.day);
        const salesValues = revData.map(d => Number(d.revenue || 0));

        const catLabels = catData.map(d => d.category);
        const catValues = catData.map(d => Number(d.count || 0));

        const cityLabels = cityData.map(d => d.city);
        const cityValues = cityData.map(d => Number(d.count || 0));

        // 1. Product Sales (Line Chart)
        const ctxSales = document.getElementById('productSalesChart').getContext('2d');
        const gradientSales = ctxSales.createLinearGradient(0, 0, 0, 260);
        gradientSales.addColorStop(0, 'rgba(44, 122, 75, 0.28)');
        gradientSales.addColorStop(1, 'rgba(44, 122, 75, 0.0)');

        if (salesChartInstance) salesChartInstance.destroy();
        salesChartInstance = new Chart(ctxSales, {
            type: 'line',
            data: {
                labels: salesLabels.length > 0 ? salesLabels : ['No Data'],
                datasets: [{
                    label: 'Revenue',
                    data: salesValues.length > 0 ? salesValues : [0],
                    borderColor: '#2c7a4b',
                    backgroundColor: gradientSales,
                    borderWidth: 2.5,
                    tension: 0.35,
                    fill: true,
                    pointBackgroundColor: '#FFFFFF',
                    pointBorderColor: '#2c7a4b',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1A1A1A',
                        padding: 10,
                        callbacks: {
                            label: function(context) { return ' ₹' + Number(context.parsed.y).toLocaleString('en-IN'); }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#F3F4F6', drawBorder: false },
                        border: { display: false },
                        ticks: {
                            callback: function(v) { return '₹' + Number(v).toLocaleString('en-IN'); }
                        }
                    },
                    x: {
                        grid: { display: false },
                        border: { display: false }
                    }
                }
            }
        });

        // 2. Categories (Doughnut Chart)
        const ctxCategories = document.getElementById('categoriesChart').getContext('2d');
        if (categoriesChartInstance) categoriesChartInstance.destroy();
        categoriesChartInstance = new Chart(ctxCategories, {
            type: 'doughnut',
            data: {
                labels: catLabels.length > 0 ? catLabels : ['Catalog Empty'],
                datasets: [{
                    data: catValues.length > 0 ? catValues : [1],
                    backgroundColor: catLabels.length > 0 
                        ? ['#2c7a4b', '#0284c7', '#d97706', '#db2777', '#7c3aed', '#059669', '#475569']
                        : ['#e2e8f0'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            boxWidth: 8,
                            padding: 12,
                            font: { size: 11, weight: '500' }
                        }
                    }
                }
            }
        });

        // 3. Sales by City (Horizontal Bar Chart)
        const ctxCity = document.getElementById('cityChart').getContext('2d');
        if (cityChartInstance) cityChartInstance.destroy();
        cityChartInstance = new Chart(ctxCity, {
            type: 'bar',
            data: {
                labels: cityLabels.length > 0 ? cityLabels : ['No city orders yet'],
                datasets: [{
                    label: 'Orders',
                    data: cityValues.length > 0 ? cityValues : [0],
                    backgroundColor: '#2c7a4b',
                    borderRadius: 4,
                    barThickness: 12
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    },
                    y: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: { font: { size: 11 }, autoSkip: false }
                    }
                }
            }
        });
    }

    async function changeDashPeriod(val) {
        document.querySelectorAll('.dash-period-select').forEach(sel => sel.value = val);
        try {
            const res = await fetch('/admin/api/dashboard-charts?period=' + val);
            const data = await res.json();
            if (data.ok) {
                renderAllCharts(data);
            }
        } catch (e) {
            console.error('Failed to load chart period:', e);
        }
    }

    // Initialize on load with dynamic data
    renderAllCharts(chartsData);
</script>

<%- include('_footer') %>